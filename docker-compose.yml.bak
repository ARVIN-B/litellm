version: "1"

services:
  litellm:
    image: ghcr.io/berriai/litellm:main-latest
    container_name: litellm

    env_file:
      - .env

    ports:
      - "127.0.0.1:4000:4000"

    volumes:
      - ./config.yaml:/app/config.yaml:ro
      - ./generated_models.yaml:/app/generated_models.yaml:ro

    command:
      - "--config"
      - "/app/config.yaml"
      - "--port"
      - "4000"

    restart: unless-stopped